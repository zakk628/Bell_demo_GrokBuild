[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;
uniform vec3 base_color : source_color = vec3(0.04, 0.10, 0.24);
uniform vec3 line_color : source_color = vec3(0.32, 0.58, 0.95);
void fragment() {
	vec3 world = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 cell = fract(world.xz);
	float line = max(step(0.96, cell.x), step(0.96, cell.y));
	ALBEDO = mix(base_color, line_color, line);
	ROUGHNESS = 1.0;
}
"

